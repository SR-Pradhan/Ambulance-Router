# Local development uses the defaults in app/db.py and app/main.py, so this
# file is only needed when pointing at a hosted database.

# Managed Postgres connection string (Neon, Render, Supabase...).
# postgres:// is normalised to postgresql:// automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma separated origins allowed to call the API, in addition to the local
# dev ports. Set this to the deployed frontend's URL.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Secret gating the destructive admin endpoints (PATCH bed counts, complete a
# trip). If this is NOT set, those endpoints refuse with 503 rather than run
# unprotected: it fails closed on purpose.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=change-me
